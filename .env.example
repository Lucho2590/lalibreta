# Firebase Web SDK (cliente)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server only, NO ponerle el prefijo NEXT_PUBLIC_)
# Generá una service account: Firebase Console > Project settings > Service accounts > Generate new private key
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Resend
# https://resend.com — generá una API key en el dashboard
RESEND_API_KEY=
# Mientras no tengas dominio verificado: "La Libreta <onboarding@resend.dev>"
# OJO: el sandbox de Resend SOLO permite mandar al email registrado en tu cuenta Resend.
# Cuando tengas el dominio: "La Libreta <hola@tu-dominio.com>"
EMAIL_FROM=La Libreta <onboarding@resend.dev>

# Para dev sin Resend: si lo ponés en true, los mails se logean en consola
# en vez de mandarse de verdad. Útil mientras esperás el dominio.
EMAIL_DEV_LOG=false

# URL base de la app (se usa en links de mails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp Cloud API (Meta for Developers > tu app > WhatsApp > API Setup)
# Token permanente: Business Settings > System users > Generate token
# (permisos whatsapp_business_messaging y whatsapp_business_management).
# El token temporal del panel dura 24 h.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Inventalo vos: el mismo valor va en "Verify token" al configurar el webhook en Meta
WHATSAPP_VERIFY_TOKEN=
# App settings > Basic > App secret (para validar la firma de los webhooks)
WHATSAPP_APP_SECRET=
# Número del bot en formato internacional, ej. 15551234567 (para los links wa.me de la web)
WHATSAPP_BOT_NUMBER=
# Opcional: versión de la Graph API (default v24.0)
# WHATSAPP_GRAPH_VERSION=v24.0
# Números de Argentina: Meta manda 549… pero la lista de destinatarios de
# prueba espera 54… (sin el 9). Por defecto se saca el 9 al responder.
# WHATSAPP_AR_STRIP_9=true

# OpenAI (agente de IA)
OPENAI_API_KEY=
# Modelo de chat (texto + visión + tools) y de transcripción de audios
OPENAI_MODEL=gpt-5.4
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Opcional: low | medium | high (si el modelo lo soporta)
# OPENAI_REASONING_EFFORT=low
# Opcional: modelo para leer fotos y PDFs (resúmenes de tarjeta). Por defecto, OPENAI_MODEL.
# OPENAI_DOCUMENT_MODEL=gpt-5.4
