rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil público mínimo: cualquier usuario autenticado puede LEER (nombre
    // y foto de las personas con las que se conecta). Solo el dueño puede
    // ESCRIBIR su propio doc.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      // Datos privados del usuario (accounts, transactions, installments,
      // categories, recurring, cycles, contacts): solo el dueño accede.
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Cuentas con gente: conexiones entre usuarios, gastos repartidos y
    // transferencias entre personas. Los ven los usuarios involucrados (uids);
    // todo se escribe desde route handlers (/api/connections, /api/splits,
    // /api/people/*) con Admin SDK, que validan conexión y estados.
    match /connections/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.uids;
      allow write: if false;
    }
    match /splits/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.uids;
      allow write: if false;
    }
    match /p2pTransfers/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.uids;
      allow write: if false;
    }

    // Gastos compartidos (modelo viejo, reemplazado por splits): solo lectura.
    match /sharedExpenses/{id} {
      allow read: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        request.auth.uid in resource.data.participantUids
      );
      allow write: if false;
    }

    // Agenda. La ven el dueño y los participantes (por uid, o por email si
    // la invitación llegó antes de que tuvieran cuenta). Desde el cliente
    // solo se crea (el dueño) y cada uno vincula/desvincula SU gasto
    // (expenses.{suUid}). Editar, cancelar y aceptar/rechazar pasan por
    // /api/activities/* para avisarles a los invitados.
    match /activities/{id} {
      allow read: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        request.auth.uid in resource.data.participantUids ||
        (request.auth.token.email != null &&
          request.auth.token.email.lower() in resource.data.participantEmails)
      );
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.participantUids;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participantUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expenses', 'updatedAt'])
        && request.resource.data.get('expenses', {}).diff(resource.data.get('expenses', {}))
             .affectedKeys().hasOnly([request.auth.uid]);
      allow delete: if false;
    }

    // Compartir cuentas (extensión). Lectura para owner y grantee.
    // Toda mutación pasa por route handlers con Admin SDK.
    match /accountShares/{id} {
      allow read: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.granteeUid == request.auth.uid
      );
      allow write: if false;
    }

    // Aprobaciones pendientes de gastos cargados por un grantee.
    // Lectura para owner y grantee. Toda mutación por route handlers.
    match /pendingApprovals/{id} {
      allow read: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        resource.data.granteeUid == request.auth.uid
      );
      allow write: if false;
    }

    // Bot de WhatsApp: vinculaciones, códigos, sesiones del agente y dedupe
    // de webhooks. Solo el server (Admin SDK) accede; el cliente usa las
    // route handlers /api/whatsapp/*.
    match /whatsappLinks/{id} {
      allow read, write: if false;
    }
    match /whatsappLinkCodes/{id} {
      allow read, write: if false;
    }
    match /whatsappSessions/{id} {
      allow read, write: if false;
    }
    match /waProcessedMessages/{id} {
      allow read, write: if false;
    }
    // Códigos para compartir cuentas por WhatsApp (solo server).
    match /accountShareCodes/{id} {
      allow read, write: if false;
    }
    // Clima: ubicación de cada usuario (GPS redondeado a ~1 km; no va en
    // users/{uid} porque ese doc lo lee cualquier logueado), alertas del SMN
    // cacheadas y metadatos de la sincronización. Solo server; la app usa
    // /api/users/location y /api/weather.
    match /userLocations/{uid} {
      allow read, write: if false;
    }
    match /weatherAlerts/{id} {
      allow read, write: if false;
    }
    match /weatherMeta/{id} {
      allow read, write: if false;
    }
    // Suscripción a la agenda desde otros calendarios: token privado → uid.
    // Solo server (/api/agenda/feed y /api/agenda/ics/<token>).
    match /calendarFeeds/{token} {
      allow read, write: if false;
    }
  }
}
